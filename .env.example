# Twilio (voice calls only — WhatsApp now goes through Meta's Cloud API below)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Must match the "Verify token" you enter in Meta App Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=

# Sarvam AI — the entire voice pipeline (STT + dialogue LLM + TTS) runs on
# Sarvam. See src/cascaded/sarvam-stt-client.ts, dialogue-client.ts,
# sarvam-tts-client.ts.
SARVAM_API_KEY=
#
# SARVAM_STT_MODEL=saaras:v3            # default; saaras:v4 also supported
# SARVAM_STT_LANGUAGE=unknown           # default: auto-detect across supported languages
# SARVAM_STT_CHUNK_MS=200                # audio buffered client-side before each STT message; lower = less tail latency, but too low (~20ms fails outright, ~100ms went silent on one real call, plausibly a rate limit) risks losing transcription reliability
# SARVAM_STT_TURN_DEBOUNCE_MS=500       # wait this long after Sarvam reports end-of-speech before treating it as the caller's actual turn, merging any continuation that arrives first — Sarvam's VAD ends a fragment on a shorter pause than natural mid-sentence thinking
#
# SARVAM_MODEL=sarvam-105b-conversations  # default. Plain "sarvam-105b" is a reasoning
#                                          # model that streams chain-of-thought before any
#                                          # real reply text — unusable for live phone dialogue.
#
# Sarvam's TTS WS protocol has no per-turn cancel, so barge-in reconnects
# instead of canceling in place — see sarvam-tts-client.ts.
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh             # or per-language: SARVAM_TTS_SPEAKER_EN / _HI / _TA / _TE

# Upstash QStash (durable callback scheduling)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# App
PUBLIC_BASE_URL=
CALL_TRIGGER_SECRET=

# Sales rep contact info (used in follow-up messages)
SALES_REP_NAME=
SALES_REP_PHONE=

# Cascaded pipeline call-flow tuning (all optional, defaults shown)
# MAX_CALL_MINUTES=6                 # hard cap; agent gives a farewell before hangup
# IDLE_TIMEOUT_SECONDS=45            # hangs up after this long with no caller speech
# END_CALL_HANGUP_DELAY_MS=3000      # grace period after "goodbye" before hanging up, so TTS isn't cut off
# DIALOGUE_MAX_HISTORY=24            # messages kept in the LLM context before trimming
# ROOM_NOISE_FILE=                   # path to a raw 8kHz mono mu-law room-tone loop; unset uses synthesized noise
# ROOM_NOISE_FILE_GAIN=0.15          # mix level when ROOM_NOISE_FILE is set
