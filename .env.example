# Twilio (voice calls only — WhatsApp now goes through Meta's Cloud API below)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Must match the "Verify token" you enter in Meta App Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# Sarvam AI — dialogue-turn LLM AND TTS voice for the cascaded pipeline
# (VOICE_PIPELINE=cascaded), used alongside OpenAI+Cartesia.
#
# Default routing (both DIALOGUE_PROVIDER and TTS_PROVIDER left unset): PER
# LANGUAGE. Tamil turns/chunks use Sarvam; Hindi, Telugu, and English use
# OpenAI (dialogue) + Cartesia (voice) — see resolveDialogueProvider() in
# dialogue-client.ts and resolveTtsProvider() in cascaded-bridge.ts.
# SARVAM_API_KEY=
#
# Force ALL turns onto one provider instead of per-language routing (e.g. for A/B testing):
# DIALOGUE_PROVIDER=            # sarvam | openai
# TTS_PROVIDER=                 # sarvam | cartesia
#
# SARVAM_MODEL=sarvam-105b-conversations  # default. Plain "sarvam-105b" is a reasoning
#                                          # model that streams chain-of-thought before any
#                                          # real reply text — unusable for live phone dialogue.
#
# DIALOGUE_MODEL=gpt-4o-mini            # OpenAI model for the non-Tamil dialogue track (default: gpt-4o-mini).
#                                        # gpt-4o follows the system prompt more reliably but costs far more
#                                        # tokens/request — only set this to gpt-4o once your OpenAI org's TPM
#                                        # rate-limit tier is raised, otherwise real calls hit 429s mid-conversation.
#
# Sarvam's TTS WS protocol has no per-turn cancel, so barge-in reconnects
# instead of canceling in place — see sarvam-tts-client.ts.
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh             # or per-language: SARVAM_TTS_SPEAKER_EN / _HI / _TA / _TE

# Upstash QStash (durable callback scheduling)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# App
PUBLIC_BASE_URL=
CALL_TRIGGER_SECRET=

# Sales rep contact info (used in follow-up messages)
SALES_REP_NAME=
SALES_REP_PHONE=

# Cascaded pipeline call-flow tuning (all optional, defaults shown)
# SONIOX_ENDPOINT_DELAY_MS=800       # silence before a caller turn is considered over; too low fragments mid-sentence pauses into separate turns
# MAX_CALL_MINUTES=6                 # hard cap; agent gives a farewell before hangup
# IDLE_TIMEOUT_SECONDS=45            # hangs up after this long with no caller speech
# END_CALL_HANGUP_DELAY_MS=3000      # grace period after "goodbye" before hanging up, so TTS isn't cut off
# DIALOGUE_MAX_HISTORY=24            # messages kept in the LLM context before trimming
# ROOM_NOISE_FILE=                   # path to a raw 8kHz mono mu-law room-tone loop; unset uses synthesized noise
# ROOM_NOISE_FILE_GAIN=0.15          # mix level when ROOM_NOISE_FILE is set
