# Twilio (voice calls only — WhatsApp now goes through Meta's Cloud API below)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Must match the "Verify token" you enter in Meta App Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# Upstash QStash (durable callback scheduling)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# App
PUBLIC_BASE_URL=
CALL_TRIGGER_SECRET=

# Sales rep contact info (used in follow-up messages)
SALES_REP_NAME=
SALES_REP_PHONE=
