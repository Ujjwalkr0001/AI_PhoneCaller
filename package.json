{
  "name": "gnani-campaign-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts && tsup apps/server/src/index.ts --format esm --platform node --target node22 --out-dir apps/server/dist --external pg-native",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint apps packages tests/platform scripts/platform eval --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/platform/migrate.ts",
    "seed": "tsx scripts/platform/seed.ts",
    "spike:gnani": "tsx scripts/spike_gnani.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.2.0",
    "@tanstack/react-query": "^5.90.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "libphonenumber-js": "^1.12.24",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.3",
    "pino": "^9.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "dotenv": "^16.4.5",
    "sarvamai": "^1.1.8",
    "twilio": "^5.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
