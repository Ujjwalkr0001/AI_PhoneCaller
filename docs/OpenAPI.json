          "languages": {
            "default": [
              "en-IN"
            ],
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "en-IN",
                "hi-IN",
                "te-IN",
                "ta-IN",
                "kn-IN",
                "ml-IN",
                "mr-IN",
                "pa-IN",
                "bn-IN",
                "gu-IN"
              ]
            }
          },
          "agent_persona": {
            "default": {
              "name": "Mira",
              "tone": "friendly"
            },
