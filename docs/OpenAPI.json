                "pattern": "^\\d{2}:\\d{2}$"
              },
              "end": {
                "default": "21:00",
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "timezone": {
                "default": "Asia/Kolkata",
