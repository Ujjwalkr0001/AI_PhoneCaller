                "const": "Asia/Kolkata"
              },
              "max_attempts": {
                "default": 2,
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "retry_gap_min": {
                "default": 60,
                "type": "integer",
                "minimum": 30,
                "maximum": 9007199254740991
              },
              "concurrency": {
                "default": 2,
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "daily_cap": {
                "default": 50,
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "daily_minutes": {
                "default": 100,
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "daily_stt_seconds": {
                "default": 6000,
                "type": "number",
                "exclusiveMinimum": 0
              },
              "daily_tts_chars": {
                "default": 100000,
                "type": "number",
                "exclusiveMinimum": 0
              }
