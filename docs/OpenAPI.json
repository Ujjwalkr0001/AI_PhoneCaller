            "additionalProperties": false
          },
          "voice": {
            "default": {
              "en-IN": "Shivani"
            },
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "en-IN",
                "hi-IN",
                "te-IN",
                "ta-IN",
                "kn-IN",
                "ml-IN",
                "mr-IN",
                "pa-IN",
                "bn-IN",
                "gu-IN"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "Shivani",
                "Avinash",
                "Lakshmi",
                "Kalpana",
                "Shubham",
                "Prakash",
                "Devansh",
                "Yashraj",
                "Chetana",
                "Vasudha",
                "Riyaa",
                "Tarika",
                "Harshad"
